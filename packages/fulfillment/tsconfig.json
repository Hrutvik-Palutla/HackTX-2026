{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@hacktx/fulfillment/http": ["./src/http.ts"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../discovery/**/*.ts", "../integrations/serpapi.ts", "../integrations/link-wallet.ts", "../integrations/reimbursements.ts", "../../apps/booking-worker/**/*.ts"]
}
