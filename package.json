{
  "name": "hacktx-2026",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json",
    "test": "vitest run",
    "db:generate": "pnpm --filter @hacktx/db generate",
    "db:migrate": "pnpm --filter @hacktx/db migrate",
    "worker": "pnpm --filter @hacktx/worker start",
    "muse:smoke": "pnpm --filter @hacktx/agent smoke",
    "agent:demo": "pnpm --filter @hacktx/agent demo",
    "test:part4": "cd packages/fulfillment && node --test test/*.test.ts ../discovery/test/*.test.ts ../integrations/link-wallet.test.ts ../../apps/booking-worker/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
