# Domain for automatic HTTPS, e.g. app.example.com. Use :80 only for an HTTP preview.
SITE_ADDRESS=:80
APP_BASE_URL=http://YOUR_SERVER_IP
BETTER_AUTH_URL=http://YOUR_SERVER_IP
# Generate these on the server. Do not commit real values.
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=
PHONE_LOOKUP_HMAC_KEY=
# Leave blank for the labeled preview. Part 2 supplies the DB and migrations.
DATABASE_URL=
