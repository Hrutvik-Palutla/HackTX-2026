# Copy to .env (git-ignored) and fill in. Placeholders only; never commit real values.
# Shared contract from IMPLEMENTATION_PLAN.md; messaging uses Claw Messenger instead of Linq.

APP_BASE_URL=http://localhost:3000
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_ENCRYPTION_KEY=
PHONE_LOOKUP_HMAC_KEY=
TEAM_ADMIN_USER_IDS=
TEAM_ADMIN_PHONES=

# Part 2: model
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
MUSE_BUDGET_USD=20

# Part 3: messaging (Claw Messenger, hosted iMessage over WebSocket)
MESSAGING_PROVIDER=claw_messenger
CLAW_MESSENGER_API_KEY=
CLAW_MESSENGER_URL=wss://claw-messenger.onrender.com/ws
# Optional local routing namespace; Claw chooses its sender automatically.
CLAW_MESSENGER_FROM_PHONE=

# Part 3: Google Calendar (OAuth web client, Testing mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Part 4: discovery, booking, payments
SERPAPI_API_KEY=
MAX_SERPAPI_REQUESTS=
BOOKING_MODE=test
BOOKING_ALLOWED_HOSTS=
LINK_AUTH_DIRECTORY=
MAX_EXTRA_SPEND_USD=40
